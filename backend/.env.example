# =============================================================================
# Personal Finance Tracker — Environment Configuration
# =============================================================================

PROJECT_NAME="Personal Finance Tracker"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security
SECRET_KEY="insecure-dev-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="financetracker"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/financetracker"

# Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:4200,http://localhost:8000"

# Structured Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
